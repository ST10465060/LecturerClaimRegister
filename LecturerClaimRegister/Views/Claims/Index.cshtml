@model IReadOnlyList<LecturerClaimRegister.Models.Claim>

@{
    ViewData["Title"] = "Claim Register";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Lecturer Claim Register</h1>
        <p class="text-muted mb-0">All claims currently captured on the system.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ New Claim</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No claims have been captured yet. Use <strong>New Claim</strong> to add one.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Lecturer</th>
                    <th>Module</th>
                    <th>Claim Month</th>
                    <th class="text-end">Hours</th>
                    <th class="text-end">Hourly Rate</th>
                    <th class="text-end">Total Amount</th>
                    <th class="text-center">Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var claim in Model)
                {
                    <tr>
                        <td>@claim.LecturerName</td>
                        <td>@claim.ModuleCode</td>
                        <td>@claim.ClaimMonth</td>
                        <td class="text-end">@claim.HoursWorked.ToString("0.##")</td>
                        <td class="text-end">@claim.HourlyRate.ToString("C")</td>
                        <td class="text-end fw-bold">@claim.TotalAmount.ToString("C")</td>
                        <td class="text-center">
                            @* Colour-code the badge so status is readable at a glance. *@
                            @{
                                var badgeClass = claim.Status switch
                                {
                                    "Approved" => "bg-success",
                                    "Pending" => "bg-warning text-dark",
                                    "Rejected" => "bg-danger",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @badgeClass">@claim.Status</span>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="table-light">
                    <td colspan="5" class="text-end fw-bold">Grand Total</td>
                    <td class="text-end fw-bold">@Model.Sum(c => c.TotalAmount).ToString("C")</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
}